# Copy to .env.local for local development. Never commit the real values.

# MongoDB on the VPS. Hex passwords only — base64 contains / and +, which
# break a connection string unless percent-encoded.
MONGODB_URI=mongodb://inventory_app:PASSWORD@db.rainbowcashandcarry.com:27019/inventory?authSource=admin&tls=true

# Signs the session cookie. Generate with: openssl rand -base64 48
# Required — the app refuses to start without it rather than falling back to a
# default, so no deployment can silently share a forgeable signing key.
# Rotating this signs everyone out.
SESSION_SECRET=

# Seeds the first admin, and ONLY while the users collection is empty. Set them
# for the first sign-in, change the password in the app, then delete both.
ADMIN_USERNAME=
ADMIN_PASSWORD=
